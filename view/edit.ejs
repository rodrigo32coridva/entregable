<%- include('partials/header') %>

<style>
  body {
    background: url('/img/FondoEdit.jpg') no-repeat center center fixed; 
    background-size: cover;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', sans-serif;
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<form id="formulario-registro" action="/edit/<%= vino.idvino %>" method="post" enctype="multipart/form-data">
  <div class="card mt-2">
    <div class="card-header"><strong>Actualización del Vino</strong></div>

    <div class="card-body">
      
      <div class="row g-2">
        <div class="col-md-6 mb-2">
          <div class="form-floating">
            <select name="marcas" id="marcas" class="form-select" required>
              <option value="" selected disabled>Seleccione</option>
              <% marcas.forEach(element => { %>
                <option value="<%= element.idmarca %>" <%= element.idmarca == vino.idmarca ? 'selected' : '' %>><%= element.marca %></option>
              <% }) %>
            </select>
            <label for="marcas">Marcas</label>
          </div>
        </div>
        <div class="col-md-6 mb-2">
          <div class="form-floating">
            <input type="text" id="nombre" value="<%= vino.nombre %>" name="nombre" class="form-control" required>
            <label for="nombre">Nombre</label>
          </div>
        </div>
      </div>

      <!-- Fila de Variedad, Año y Tipo -->
      <div class="row g-2">
        <div class="col-md-4 mb-2">
          <div class="form-floating">
            <input type="text" id="variedad" value="<%= vino.variedad %>" name="variedad" class="form-control" required>
            <label for="variedad">Variedad</label>
          </div>
        </div>
        <div class="col-md-4 mb-2">
          <div class="form-floating">
            <input type="number" id="anio" value="<%= vino.anio %>" name="anio" class="form-control" required>
            <label for="anio">Año</label>
          </div>
        </div>
        <div class="col-md-4 mb-2">
          <div class="form-floating">
            <select name="tipo" id="tipo" class="form-select" required>
              <option value="" disabled>Seleccione</option>
              <option value="Tinto" <%= vino.tipo === 'Tinto' ? 'selected' : '' %>>Tinto</option>
              <option value="Blanco" <%= vino.tipo === 'Blanco' ? 'selected' : '' %>>Blanco</option>
              <option value="Rosado" <%= vino.tipo === 'Rosado' ? 'selected' : '' %>>Rosado</option>
              <option value="Espumante" <%= vino.tipo === 'Espumante' ? 'selected' : '' %>>Espumante</option>
            </select>
            <label for="tipo">Tipo</label>
          </div>
        </div>
      </div>

      <!-- Fila de Alcohol y Precio -->
      <div class="row g-2">
        <div class="col-md-6 mb-2">
          <div class="form-floating">
            <input type="number" id="alcohol" value="<%= vino.alcohol %>" name="alcohol" class="form-control" required>
            <label for="alcohol">Alcohol (%)</label>
          </div>
        </div>
        <div class="col-md-6 mb-2">
          <div class="form-floating">
            <input type="number" id="precio" value="<%= vino.precio %>" name="precio" step="0.01" class="form-control" required>
            <label for="precio">Precio</label>
          </div>
        </div>
      </div>

      <!-- Fila de Imagen Actual y Subir Nueva Imagen -->
      <div class="row g-2 mt-2">
        <% if (vino.imagen_url) { %>
          <div class="col-md-6">
            <p>Imagen actual:</p>
            <img src="<%= vino.imagen_url %>" alt="Imagen actual" style="max-width: 120px;">
          </div>
        <% } %>
        <div class="col-md-6">
          <label for="imagen">Subir nueva imagen (opcional):</label>
          <input type="file" name="imagen" id="imagen" class="form-control">
          <!-- Contenedor de la previsualización de la imagen -->
          <div id="image-preview-container" style="margin-top: 10px; display: none;">
            <img id="image-preview" src="" alt="Previsualización" style="max-width: 120px; max-height: 120px;">
          </div>
        </div>
      </div>

    </div>

    <div class="card-footer">
      <button type="submit" class="btn btn-sm btn-primary">Guardar</button>
      <a href="/catalogo" class="btn btn-sm btn-secondary">Cancelar</a>
    </div>
  </div>
</form>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const formulario = document.querySelector("#formulario-registro");
    const imagenInput = document.querySelector("#imagen");
    const previewContainer = document.querySelector("#image-preview-container");
    const imagePreview = document.querySelector("#image-preview");

    // Mostrar previsualización cuando se selecciona un archivo
    imagenInput.addEventListener("change", (event) => {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          imagePreview.src = e.target.result;
          previewContainer.style.display = 'block'; // Mostrar el contenedor de previsualización
        };
        reader.readAsDataURL(file);
      } else {
        previewContainer.style.display = 'none'; // Ocultar el contenedor si no se selecciona imagen
      }
    });

    formulario.addEventListener("submit", (event) => {
      event.preventDefault();

      Swal.fire({
        title: '¿Está seguro de actualizar el vino?',
        text: '¡Los cambios serán guardados!',
        icon: 'question',
        footer: 'SENATI - Ingeniería Software',
        confirmButtonText: 'Aceptar',
        confirmButtonColor: '#2980b9',
        showCancelButton: true,
        cancelButtonText: 'Cancelar',
        cancelButtonColor: '#c0392b'
      }).then((result) => {
        if (result.isConfirmed) {
          formulario.submit();
        }
      });
    });
  });
</script>

<%- include('partials/footer') %>
